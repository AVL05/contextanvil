{
  "name": "contextanvil",
  "version": "0.2.0-beta.1",
  "description": "Audit repository instructions, compile traceable context, and verify repository snapshots offline.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AVL05/contextanvil.git"
  },
  "homepage": "https://github.com/AVL05/contextanvil#readme",
  "bugs": {
    "url": "https://github.com/AVL05/contextanvil/issues"
  },
  "keywords": [
    "context-engineering",
    "ai-agents",
    "coding-agents",
    "agents-md",
    "claude-md",
    "repository-analysis",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "beta",
    "access": "public"
  },
  "type": "module",
  "bin": {
    "contextanvil": "./bin/contextanvil.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs/security.md",
    "docs/design/phase-2-manifests.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "scan:self": "node bin/contextanvil.js scan .",
    "doctor:self": "node bin/contextanvil.js doctor .",
    "bench": "node bench/run.js --out bench/results/latest.json --md bench/results/latest.md",
    "bench:quick": "node bench/run.js --quick --no-perf",
    "bench:digest": "node bench/digest.js"
  }
}
