{
  "name": "contextanvil",
  "version": "0.1.0",
  "description": "Forge better context. Deterministic repository analysis and task-aware context compilation for AI coding agents.",
  "keywords": [
    "context-engineering",
    "ai-agents",
    "coding-agents",
    "agents-md",
    "claude-md",
    "repository-analysis",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "contextanvil": "./bin/contextanvil.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "scan:self": "node bin/contextanvil.js scan .",
    "doctor:self": "node bin/contextanvil.js doctor ."
  }
}
