=== lib/auth/password.ts ===
import { randomBytes, scrypt, timingSafeEqual } from 'node:crypto';

export async function hashPassword(password: string): Promise<string> {
  const salt = randomBytes(16).toString('hex');
  const key = await derive(password, salt);
  return `${salt}:${key.toString('hex')}`;
}

export async function verifyPassword(password: string, stored: string): Promise<boolean> {
  const [salt, hash] = stored.split(':');
  const key = await derive(password, salt);
  return timingSafeEqual(key, Buffer.from(hash, 'hex'));
}

export async function signToken(payload: object): Promise<string> {
  return Buffer.from(JSON.stringify(payload)).toString('base64url');
}

export async function verifyToken(token: string) {
  return JSON.parse(Buffer.from(token, 'base64url').toString());
}

function derive(password: string, salt: string): Promise<Buffer> {
  return new Promise((resolve, reject) => scrypt(password, salt, 64, (err, key) => (err ? reject(err) : resolve(key))));
}
=== lib/cart/store.ts ===
import { db } from '@/lib/db';

export type CartItem = { productId: string; name: string; priceCents: number; quantity: number };
export type Cart = { items: CartItem[]; discountCode?: string };

export async function loadCart(): Promise<Cart> {
  return (await db.get('cart')) ?? { items: [] };
}

export async function saveCart(cart: Cart): Promise<void> {
  await db.set('cart', cart);
}
=== lib/cart/totals.ts ===
import type { CartItem } from '@/lib/cart/store';

const DISCOUNTS: Record<string, number> = { WELCOME10: 0.1, SPRING20: 0.2 };

export function roundCents(value: number): number {
  return Math.floor(value);
}

export function cartTotals(items: CartItem[], discountCode?: string) {
  const subtotalCents = items.reduce((sum, item) => sum + item.priceCents * item.quantity, 0);
  const rate = discountCode ? DISCOUNTS[discountCode] ?? 0 : 0;
  const discountCents = roundCents(subtotalCents * rate);
  return { subtotalCents, discountCents, totalCents: subtotalCents - discountCents };
}
