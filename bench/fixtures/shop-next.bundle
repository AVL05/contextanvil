=== app/api/cart/route.ts ===
import { NextResponse } from 'next/server';
import { loadCart, saveCart } from '@/lib/cart/store';

export async function GET() {
  return NextResponse.json(await loadCart());
}

export async function PUT(request: Request) {
  const body = await request.json();
  await saveCart(body);
  return NextResponse.json({ ok: true });
}
=== app/api/auth/login/route.ts ===
import { NextResponse } from 'next/server';
import { verifyPassword } from '@/lib/auth/password';
import { createSession } from '@/lib/auth/session';
import { findUserByEmail } from '@/lib/db';

export async function POST(request: Request) {
  const { email, password } = await request.json();
  const user = await findUserByEmail(email);
  if (!user || !(await verifyPassword(password, user.passwordHash))) {
    return NextResponse.json({ error: 'Invalid credentials' }, { status: 401 });
  }
  const response = NextResponse.json({ ok: true });
  await createSession(response, user.id);
  return response;
}
=== app/api/checkout/route.ts ===
import { NextResponse } from 'next/server';
import { loadCart } from '@/lib/cart/store';
import { cartTotals } from '@/lib/cart/totals';
import { createCheckoutSession } from '@/lib/payments/stripe';

export async function POST() {
  const cart = await loadCart();
  const totals = cartTotals(cart.items, cart.discountCode);
  const session = await createCheckoutSession(cart.items, totals.totalCents);
  return NextResponse.json({ url: session.url });
}
