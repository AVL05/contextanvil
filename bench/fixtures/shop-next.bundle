import { describe, expect, it } from 'vitest';
import { cartTotals } from './totals';

describe('cartTotals', () => {
  it('applies a percentage discount', () => {
    const totals = cartTotals([{ productId: 'a', name: 'A', priceCents: 1000, quantity: 1 }], 'WELCOME10');
    expect(totals.discountCents).toBe(100);
