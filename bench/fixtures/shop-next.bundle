=== lib/products/catalog.ts ===
import { db } from '@/lib/db';

export async function listProducts({ page, pageSize }: { page: number; pageSize: number }) {
  const all = (await db.get('products')) ?? [];
  return all.slice((page - 1) * pageSize, page * pageSize);
}

export async function listFeatured() {
  return listProducts({ page: 1, pageSize: 8 });
}

export async function getProduct(id: string) {
  const all = (await db.get('products')) ?? [];
  return all.find((p: { id: string }) => p.id === id);
}
=== lib/payments/stripe.ts ===
import Stripe from 'stripe';

const stripe = new Stripe(process.env.STRIPE_SECRET_KEY ?? '');

export async function createCheckoutSession(items: { name: string; priceCents: number; quantity: number }[], totalCents: number) {
  return stripe.checkout.sessions.create({
    mode: 'payment',
    success_url: `${process.env.APP_URL}/thanks`,
    line_items: items.map((i) => ({ quantity: i.quantity, price_data: { currency: 'usd', unit_amount: i.priceCents, product_data: { name: i.name } } })),
    metadata: { totalCents: String(totalCents) },
  });
}
=== lib/format/currency.ts ===
export function formatCurrency(cents: number, currency = 'USD', locale = 'en-US'): string {
  return new Intl.NumberFormat(locale, { style: 'currency', currency }).format(cents / 100);
}
=== lib/db.ts ===
const store = new Map<string, unknown>();

export const db = {
  async get(key: string) {
    return store.get(key) as any;
  },
  async set(key: string, value: unknown) {
    store.set(key, value);
  },
};

export async function findUserByEmail(email: string) {
  return (await db.get(`user:${email}`)) as { id: string; passwordHash: string } | undefined;
}
=== e2e/checkout.spec.ts ===
import { test, expect } from '@playwright/test';

test('a customer can pay for a cart', async ({ page }) => {
  await page.goto('/products');
  await page.getByText('Add to cart').first().click();
  await page.goto('/checkout');
  await expect(page.getByText('Pay now')).toBeVisible();
});
