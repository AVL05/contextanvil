=== app/Http/Requests/StoreOrderRequest.php ===
<?php

namespace App\Http\Requests;

class StoreOrderRequest
{
    public function rules(): array
    {
        return [
            'items' => ['required', 'array', 'min:1'],
            'items.*.product_id' => ['required', 'exists:products,id'],
            'items.*.quantity' => ['required', 'integer', 'min:1'],
        ];
    }

    public function items(): array
    {
        return $this->validated()['items'];
    }
}
=== app/Http/Middleware/EnsureUserIsAdmin.php ===
<?php

namespace App\Http\Middleware;

use Closure;

class EnsureUserIsAdmin
{
    public function handle($request, Closure $next)
    {
        abort_unless($request->user()?->isAdmin(), 403);

        return $next($request);
    }
}
=== app/Services/PricingService.php ===
<?php

namespace App\Services;

use App\Models\Product;

class PricingService
{
    public function total(array $items): int
    {
        $total = 0;
        foreach ($items as $item) {
            $product = Product::find($item['product_id']);
            $total += $product->price_cents * $item['quantity'];
        }

        return $total;
    }

    public function applyTax(int $cents, float $rate): int
    {
        return (int) round($cents * (1 + $rate));
    }
}
=== app/Services/InventoryService.php ===
<?php

namespace App\Services;

use App\Models\Product;

class InventoryService
{
    public function reserve(array $items): void
    {
        foreach ($items as $item) {
            Product::where('id', $item['product_id'])->decrement('stock', $item['quantity']);
        }
    }
}
=== app/Services/InvoiceGenerator.php ===
<?php

namespace App\Services;

use App\Models\Order;

class InvoiceGenerator
{
    public function render(Order $order): string
    {
        $lines = [];
        foreach ($order->items as $item) {
            $lines[] = sprintf('%s x %d', $item->product->name, $item->quantity);
        }

        return implode("\n", $lines);
    }
}
=== app/Policies/OrderPolicy.php ===
<?php

namespace App\Policies;

use App\Models\Order;
use App\Models\User;

class OrderPolicy
{
    public function view(User $user, Order $order): bool
    {
        return $user->isAdmin() || $order->user_id === $user->id;
    }

    public function delete(User $user, Order $order): bool
    {
        return $order->user_id === $user->id;
    }
}
