=== app/Console/Commands/PruneAbandonedOrders.php ===
<?php

namespace App\Console\Commands;

use App\Models\Order;

class PruneAbandonedOrders
{
    protected $signature = 'orders:prune';

    public function handle(): void
    {
        Order::where('status', Order::STATUS_PENDING)->where('created_at', '<', now()->subDays(7))->delete();
    }
}
